{
  "name": "revaulter-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "e2e": "pnpm run e2e:build-server && playwright test",
    "e2e:build-server": "vite build --mode e2e && mkdir -p ../../.bin && GOEXPERIMENT=jsonv2 go build -tags e2e -o ../../.bin/revaulter-e2e ../../cmd/revaulter",
    "e2e:headed": "pnpm run e2e:build-server && playwright test --headed",
    "e2e:install": "playwright install --with-deps chromium",
    "format": "biome format --write .",
    "lint": "biome lint . && svelte-check",
    "lint:biome": "biome lint .",
    "lint:svelte": "svelte-check",
    "check": "biome check --write .",
    "svelte-check": "svelte-check",
    "test": "vitest run",
    "analyze": "cross-replace vite build --mode analyze"
  },
  "packageManager": "pnpm@10.30.1",
  "dependencies": {
    "@awasm/noble": "0.1.4",
    "@fontsource-variable/geist": "5.2.9",
    "@fontsource-variable/geist-mono": "5.2.8",
    "@noble/curves": "2.2.0",
    "@noble/post-quantum": "0.6.1",
    "arraybuffer-encoding": "1.1.0",
    "date-fns": "4.4.0",
    "js-cookie": "3.0.8",
    "tailwindcss": "4.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@playwright/test": "1.60.0",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/vite": "4.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/js-cookie": "3.0.6",
    "@types/node": "24.12.2",
    "cross-replace": "0.2.0",
    "cssnano": "8.0.2",
    "postcss": "8.5.15",
    "postcss-import": "16.1.1",
    "postcss-url": "10.1.4",
    "svelte": "5.56.2",
    "svelte-check": "4.6.0",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vite-bundle-analyzer": "1.3.8",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-sri-gen": "1.6.1",
    "vitest": "4.1.9"
  }
}
