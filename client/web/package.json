{
  "name": "revaulter-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "e2e": "pnpm run e2e:build-server && playwright test",
    "e2e:build-server": "vite build --mode e2e && mkdir -p ../../.bin && go build -tags e2e -o ../../.bin/revaulter-e2e ../../cmd/revaulter",
    "e2e:headed": "pnpm run e2e:build-server && playwright test --headed",
    "e2e:install": "node ./e2e/install-browsers.mjs",
    "format": "biome format --write .",
    "lint": "biome lint . && svelte-check",
    "lint:biome": "biome lint .",
    "lint:svelte": "svelte-check",
    "check": "biome check --write .",
    "svelte-check": "svelte-check",
    "test": "vitest run",
    "analyze": "cross-replace vite build --mode analyze"
  },
  "packageManager": "pnpm@12.5.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.13.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@awasm/noble": "0.1.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@noble/curves": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "arraybuffer-encoding": "1.1.0",
    "date-fns": "4.4.0",
    "js-cookie": "3.0.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/svelte": "5.0.8",
    "@types/js-cookie": "3.0.6",
    "@types/node": "26.5.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cross-replace": "0.2.0",
    "cssnano": "9.0.4",
    "postcss": "8.5.28",
    "postcss-import": "17.0.0",
    "postcss-url": "10.1.4",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-bundle-analyzer": "1.3.9",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-sri-gen": "1.7.4",
    "vitest": "5.0.1"
  }
}
